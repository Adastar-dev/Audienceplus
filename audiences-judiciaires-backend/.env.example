APP_NAME="Audiences Judiciaires"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=file
QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=audiences_judiciaires
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Domaines autorises pour l'auth SPA Sanctum (le frontend Vite tourne sur 5173)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

FILESYSTEM_DISK=local

# Jitsi auto-heberge (services jitsi-* du docker-compose.yml), authentification JWT.
# JITSI_APP_SECRET doit etre identique a JITSI_JWT_SECRET cote docker-compose.
# Laisser JITSI_APP_SECRET vide pour retomber sur meet.jit.si (dev sans Docker).
JITSI_DOMAIN=localhost:8443
JITSI_APP_ID=audiences_judiciaires
JITSI_APP_SECRET=

# Transcription automatique de l'audio des audiences (Whisper) + OCR de la CNI
# Transcription audio et lecture de la CNI : Groq par défaut (gratuit,
# clé à créer sur console.groq.com > API Keys).
IA_API_KEY=
IA_BASE_URL=https://api.groq.com/openai/v1
IA_MODELE_TRANSCRIPTION=whisper-large-v3
IA_MODELE_VISION=qwen/qwen3.8-27b
