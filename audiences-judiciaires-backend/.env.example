APP_NAME="Audiences Judiciaires"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=file
QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=audiences_judiciaires
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Domaines autorises pour l'auth SPA Sanctum (le frontend Vite tourne sur 5173)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

FILESYSTEM_DISK=local

# Jitsi auto-heberge (services jitsi-* du docker-compose.yml), authentification JWT.
# JITSI_APP_SECRET doit etre identique a JITSI_JWT_SECRET cote docker-compose.
# Laisser JITSI_APP_SECRET vide pour retomber sur meet.jit.si (dev sans Docker).
JITSI_DOMAIN=localhost:8443
JITSI_APP_ID=audiences_judiciaires
JITSI_APP_SECRET=

# Orange SMS API Sénégal (OTP par SMS) - a completer une fois l'app approuvée
# par l'équipe locale Orange sur developer.orange.com (MyApps)
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=

# Transcription automatique de l'audio des audiences (Whisper) + OCR de la CNI
OPENAI_API_KEY=
